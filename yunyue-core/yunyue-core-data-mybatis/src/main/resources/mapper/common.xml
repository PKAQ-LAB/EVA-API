<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="common">
    <resultMap id="resultMap" type="tech.yunyue.core.mybatis.mvc.entity.mybatis.StdEntity" extends="resultNoTenantMap">
        <result column="TENANT_ID" jdbcType="VARCHAR" property="tenantId"/>
    </resultMap>
    <resultMap id="resultNoTenantMap" type="tech.yunyue.core.mybatis.mvc.entity.mybatis.StdEntity">
        <id column="ID" jdbcType="VARCHAR" property="id"/>
        <result column="REMARK" jdbcType="VARCHAR" property="remark"/>
        <result column="REVISION" jdbcType="INTEGER" property="revision"/>
        <result column="DELETED" jdbcType="VARCHAR" property="deleted"/>
        <result column="POST_ID" jdbcType="VARCHAR" property="postId"/>
        <result column="ORG_ID" jdbcType="VARCHAR" property="orgId"/>
        <result column="CREATE_ID" jdbcType="VARCHAR" property="createId"/>
        <result column="CREATE_BY" jdbcType="VARCHAR" property="createBy"/>
        <result column="GMT_CREATE" jdbcType="TIMESTAMP" property="gmtCreate"/>
        <result column="MODIFY_ID" jdbcType="VARCHAR" property="modifyId"/>
        <result column="MODIFY_BY" jdbcType="VARCHAR" property="modifyBy"/>
        <result column="GMT_MODIFY" jdbcType="TIMESTAMP" property="gmtModify"/>
    </resultMap>

    <sql id="andDataPermissionSql">
        <bind name="alias" value="'${alias}'" />
        and ${@tech.yunyue.config.MybatisPlusDataPermissionHandler@permissionSql(alias)}
    </sql>

    <!--$才能拿到property中的value  #拿到的是mapper接口的参数  但是$中不能包含$ 所以使用bind绑定在当前环境 -->
    <sql id="whereDataPermissionSql">
        <bind name="alias" value="'${alias}'" />
        where ${@tech.yunyue.config.MybatisPlusDataPermissionHandler@permissionSql(alias)}
    </sql>

    <sql id="deletedSQL">
        <choose>
            <when test="@tech.yunyue.core.enums.DeleteEnumm@NOT_DELETE.code == null">
                is null
            </when>
            <otherwise>
                = '${@tech.yunyue.core.enums.DeleteEnumm@NOT_DELETE.code}'
            </otherwise>
        </choose>
    </sql>

    <sql id="preFixDeletedSQL">
        <choose>
            <when test="@tech.yunyue.core.enums.DeleteEnumm@NOT_DELETE.code == null">
            DELETED is null
            </when>
            <otherwise>
            DELETED = '${@tech.yunyue.core.enums.DeleteEnumm@NOT_DELETE.code}'
            </otherwise>
        </choose>
    </sql>
</mapper>

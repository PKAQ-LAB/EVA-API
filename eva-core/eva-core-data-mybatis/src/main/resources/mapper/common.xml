<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="common">
    <!-- 公共字段   -->
    <resultMap id="resultMap" type="org.pkaq.core.mybatis.mvc.entity.StdEntity">
        <id property="id" column="id"/>
        <result property="revision" column="revision"/>
        <result property="deleted" column="deleted"/>
        <result property="frozen" column="frozen"/>
        <result property="sort" column="sort"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="createId" column="create_id"/>
        <result property="createBy" column="create_by"/>
        <result property="utcCreate" column="utc_create"/>
        <result property="modifyId" column="modify_id"/>
        <result property="modifyBy" column="modify_by"/>
        <result property="utcModify" column="utc_modify"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <!-- 删除片段 -->
    <sql id="avalibleSQL">
        ${prefix}.deleted = 0 OR ${prefix}.deleted IS NULL
    </sql>
    <sql id="deletedSQL">
        DELETED > 0
    </sql>
    <!-- 非冻结片段 -->
    <sql id="unFrozenSQL">
        FROZEN != 1
    </sql>
</mapper>
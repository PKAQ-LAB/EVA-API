<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.pkaq.sys.user.mapper.UserMapper">
    <resultMap id="BaseResultMap" type="org.pkaq.sys.user.vo.UserDetailVo" extends="common.resultMap">
        <id property="id" column="ID"/>
    </resultMap>
    <!-- 获取包含模块权限列表的用户信息 -->
    <resultMap id="UserWithModuleAndRole" type="user" extends="BaseResultMap">
        <collection property="roles" column="{userId=id}"
                    select="org.pkaq.sys.role.mapper.RoleMapper.selectByUserId" ofType="role"/>
        <collection property="modules" column="{userId=id}"
                    select="org.pkaq.sys.module.mapper.ModuleMapper.getRoleModuleByUserId" ofType="module"/>
    </resultMap>

    <!-- 获取包含权限列表的用户信息 -->
    <resultMap id="UserWithRoleId" type="user" extends="BaseResultMap">
        <collection property="roles" javaType="java.util.List" ofType="roleUser">
            <id column="R_ID" property="id" jdbcType="VARCHAR"/>
            <result column="ROLE_ID" property="roleId" jdbcType="VARCHAR"/>
        </collection>
    </resultMap>

    <!-- 根据id更新用户锁定状态 -->
    <update id="change">
        update sys_user set frozen = abs(frozen - 1)
        <where>
            <if test="null != ids and '' != ids">
                id in
                <foreach collection="ids" item="id" index="index" open="(" close=")" separator=",">
                    #{id}
                </foreach>
            </if>
        </where>
    </update>

    <select id="getUerWithRoleId" resultMap="UserWithRoleId">
        SELECT
            su.*,
            sru.id R_ID,
            sru.ROLE_ID
        FROM
            SYS_USER su
        LEFT JOIN SYS_ROLEUSER_REF sru
            ON su.id = sru.USER_ID
        <where>
            <if test="null != user.deptId and user.deptId != ''">
                su.dept_Id = #{user.deptId,jdbcType=VARCHAR}
            </if>
            <if test="null != user.account and user.account != ''">
                and su.account = #{user.account,jdbcType=VARCHAR}
            </if>
            <if test="null != user.name and user.name != ''">
                and su.name = #{user.name,jdbcType=VARCHAR}
            </if>
            <if test="null != user.tel and user.tel != ''">
                and su.tel = #{user.tel,jdbcType=VARCHAR}
            </if>
        </where>
    </select>

    <!-- 根据用户ID获取包含模块权限列表的用户信息 -->
    <select id="getUserWithModuleAndRoleById" resultMap="UserWithModuleAndRole">
        select *
        from SYS_USER
        where id = #{userId}
    </select>

    <select id="availableCounts" resultType="java.lang.Integer">
        SELECT
        <if test="_databaseId == 'mysql'">
            T.AUTH_USER_COUNT - IFNULL(U.USER_COUNT, 0) AS ct
        </if>
        <if test="_databaseId == 'postgre'">
            T.AUTH_USER_COUNT - COALESCE(U.USER_COUNT, 0) AS ct
        </if>
        FROM SYS_TENANT T
             LEFT JOIN (
                SELECT
                    TENANT_ID, COUNT(*) AS USER_COUNT
                FROM SYS_USER
                    WHERE (SYS_USER.DELETED = 0 OR SYS_USER.DELETED IS NULL)
                        AND TENANT_ID = #{tid}
                GROUP BY TENANT_ID
        ) U ON U.TENANT_ID = T.ID
                WHERE (T.DELETED = 0 OR T.DELETED IS NULL)
                    AND T.ID = #{tid}
    </select>
</mapper>

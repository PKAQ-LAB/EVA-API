<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.pkaq.sys.role.mapper.RoleUserMapper">
    <select id="selectRoleIds" resultType="java.lang.String" parameterType="java.lang.String">
        select ROLE_ID from SYS_ROLEUSER_REF
        <where>
            USER_ID = #{id}
        </where>
    </select>
</mapper>
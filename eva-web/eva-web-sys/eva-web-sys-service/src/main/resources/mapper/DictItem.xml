<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.pkaq.sys.dict.mapper.DictItemMapper">
    <resultMap id="BaseResultMap" type="dictItem" extends="common.resultMap">
        <result column="MAIN_ID" property="dictId"/>
    </resultMap>
    <!--根据字典ID查询数据-->
    <select id="listItemByDictId" resultType="dictItem">
        select *
        from sys_dict_item
        where main_id = #{dictId}
        order by sort
    </select>
</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.pkaq.sys.tenant.pkg.mapper.TenantPackageResourceMapper">
    <select id="selectAuthorizedResourceIds" resultType="java.lang.Long">
        SELECT RESOURCE_ID
        FROM SYS_TENANT_PACKAGE_RESOURCE
        WHERE PACKAGE_ID = #{packageId}
    </select>
</mapper>

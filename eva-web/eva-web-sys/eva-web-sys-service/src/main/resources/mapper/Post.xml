<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.yunyue.sys.post.mapper.PostMapper">


    <!-- 岗位模块分页列表 -->
    <select id="list" resultType="org.pkaq.sys.post.vo.PostListVo">
        SELECT
            y.ID,
            y.`CODE`,
            y.`TITLE`,
            y.`LEVEL`,
            y.PID,
            y.`SORT`,
            s.TITLE AS PARENT_NAME,
            y.REMARK
        FROM
            SYS_POST y
        LEFT JOIN SYS_POST s ON s.ID = y.PARENT_ID
        <choose>
            <when test="q != null">
                <where>
                    AND y.<include refid="common.avalibleSQL"/>
                    <if test="q.title!=null and q.title !=''">
                        AND y.TITLE like concat('%',#{q.title},'%')
                    </if>
                    <if test="q.level!=null and q.level !=''">
                        AND y.LEVEL like concat('%',#{q.level},'%')
                    </if>
                </where>
            </when>
        </choose>
        ORDER BY
        y.SORTS ASC,
        y.GMT_MODIFY DESC
    </select>


</mapper>

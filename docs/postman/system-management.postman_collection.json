  "item": [
    {
      "name": "认证",
      "item": [
        {
          "name": "登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data || {};",
                  "const accessToken = data.accessToken || data.access_token || json.accessToken || json.access_token;",
                  "const refreshToken = data.refreshToken || data.refresh_token || json.refreshToken || json.refresh_token;",
                  "if (accessToken) {",
                  "  pm.collectionVariables.set('accessToken', accessToken);",
                  "}",
                  "if (refreshToken) {",
                  "  pm.collectionVariables.set('refreshToken', refreshToken);",
                  "}",
                  "pm.test('已获取 accessToken', function () {",
                  "  pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"{{loginAccount}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "刷新 accessToken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/getAlpha",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
